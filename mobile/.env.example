# Copy to .env and set the LAN address of the machine running the Laravel API.
#
# "localhost" does NOT work from a phone — it resolves to the phone itself.
# Find your machine's address with `ipconfig` (Windows) or `ifconfig` (macOS/Linux),
# and make sure the phone is on the same Wi-Fi network.
#
# Production and preview builds get this from the EAS build profile instead,
# and it must be https:// there — src/lib/env.ts refuses to start otherwise.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8001/api/v1

# Google Sign-In. One OAuth client per platform, all in the same Google Cloud
# project, created under APIs & Services > Credentials.
#
# These are NOT secrets — a client id identifies the app and authorises nothing,
# and Google puts it in the authorisation URL anyway. Never add a client secret:
# a mobile app cannot keep one, which is why this flow uses PKCE instead.
#
# The app uses the id for the platform it is running on, and that id becomes the
# `aud` claim on the ID token. So an Android build needs the ANDROID id, and
# whatever you set here must also appear in the backend's GOOGLE_CLIENT_IDS or
# the API rejects every token as issued to another app. The web id is only
# needed for the student web area, later.
#
# Android also matches the app's signing SHA-1, and EAS dev, EAS preview and
# Play App Signing are three different fingerprints — register all three.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
