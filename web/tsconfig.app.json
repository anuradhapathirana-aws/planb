{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/src/*"],

      /*
       * shared/ has no node_modules of its own — by design, it installs nothing.
       * Node resolution from shared/src/** walks up past planb/ and never reaches
       * web/node_modules, so its peerDependencies are pointed here explicitly.
       * Bundlers don't need this (Vite and Metro resolve bare imports from the app
       * root), only tsc does. Add an entry whenever shared/ gains a peer dep.
       */
      "axios": ["./node_modules/axios"],
      "react-hook-form": ["./node_modules/react-hook-form"],
      "zod": ["./node_modules/zod"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "../shared/src"]
}
