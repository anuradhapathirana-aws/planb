# Everything here is compiled into the public bundle. Treat every value as if it
# were printed on the homepage — never put a secret or an API key in this file.
VITE_API_BASE_URL=http://localhost:8001/api/v1
VITE_API_URL=http://localhost:8001
VITE_APP_NAME="Plan B International"

# Google OAuth **Web** client id for "Continue with Google" in the sign-in dialog.
# Public by design (Google shows it in its own popup) — but it is NOT a secret
# only because it is a client id; never put a client SECRET here. It must also be
# listed in the backend's GOOGLE_CLIENT_IDS, and this site's origin must be an
# "Authorised JavaScript origin" on the client in Google Cloud Console.
# Leave blank to hide the Google button; the emailed code still works.
VITE_GOOGLE_CLIENT_ID=

# Absolute origin of this site, used to build canonical and OpenGraph URLs.
VITE_SITE_URL=http://localhost:5184
