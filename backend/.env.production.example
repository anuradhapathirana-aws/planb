# =============================================================================
# Plan B International API — PRODUCTION environment template
# =============================================================================
# On the server:   cp .env.production.example .env && chmod 600 .env && nano .env
# Walkthrough:     docs/deployment.md, Part 6
#
# PLACEHOLDERS ONLY. Never put a real password, key or code in this file — it is
# committed. Every <angle-bracket> value must be replaced, and every blank secret
# filled, before `php artisan config:cache`.
#
# Local development uses .env.example instead. Values here are deliberately
# different: debug off, secure cookies, real mail, no sandbox payments.
# tests/Feature/EnvironmentTemplateTest.php fails if this file drifts unsafe.
# =============================================================================

APP_NAME="Plan B International"
APP_ENV=production
# Generated on the server with `php artisan key:generate`. Never copy one from
# another machine: it decrypts sessions and signs every private link.
APP_KEY=
# true shows stack traces, config values and SQL to anyone who triggers an error.
APP_DEBUG=false
APP_TIMEZONE=UTC
# The public API host, https. Course and service images build their links from
# this (config/filesystems.php, disks.public.url), so a wrong value breaks every
# image while the API itself still works.
APP_URL=https://api.<domain>
# The admin panel. CORS allows only this origin.
FRONTEND_URL=https://admin.<domain>

# Behind Cloudflare's proxy (docs/deployment.md Part 2): `cloudflare`.
# Blank only if Cloudflare is not proxying. `*` is refused.
TRUSTED_PROXIES=cloudflare

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# One file per day, kept 14 days. `warning` keeps failures and drops the
# per-request noise that would fill the disk.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=planb
DB_USERNAME=planb
DB_PASSWORD=

# --- Admin sign-in (cookie session shared by api.<domain> and admin.<domain>) --
SESSION_DRIVER=database
# Minutes of inactivity. Each request renews it, so an admin who is working is
# never signed out; a panel left open and unattended is.
SESSION_LIFETIME=120
# Session contents are encrypted in the `sessions` table, so a database dump or
# backup does not hand out live admin sessions.
SESSION_ENCRYPT=true
SESSION_PATH=/
# The leading dot is what shares the cookie between api. and admin. — without it
# admin login appears to succeed and bounces straight back to the login screen.
SESSION_DOMAIN=.<domain>
# The cookie is only ever sent over HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=admin.<domain>

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# No Redis on this server. The database queue needs the Supervisor workers in
# docs/deployment.md Part 9, or sign-in emails are never sent.
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

# --- Email (Brevo SMTP, docs/deployment.md Part 8) ----------------------------
# Never `log` here: sign-in codes would go to the log file and nobody could sign in.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=<brevo-login>
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@<domain>"
MAIL_FROM_NAME="Plan B Academy"
MAIL_SUPPORT_ADDRESS="support@<domain>"

# --- Public legal pages (/privacy, /terms, /account-deletion) -----------------
LEGAL_COMPANY_NAME="Plan B International Private Limited"
LEGAL_APP_NAME="Plan B Academy"
# Shown on the pages exactly as typed; blank leaves the line off. Fill both before launch.
LEGAL_COMPANY_ADDRESS=
LEGAL_COMPANY_REGISTRATION_NUMBER=
LEGAL_PAYMENT_RETENTION_YEARS=7
LEGAL_DELETION_REQUEST_DAYS=30

# --- Lesson video (Bunny Stream, docs/bunny-stream-setup.md) ------------------
BUNNY_STREAM_ENABLED=true
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_WEBHOOK_KEY=
BUNNY_STREAM_RESOLUTIONS=240p,360p,480p,720p
COURSE_MAX_THUMBNAIL_UPLOAD_MB=2

# --- Student app sign-in -------------------------------------------------------
STUDENT_LOGIN_CODE_TTL_MINUTES=10
STUDENT_LOGIN_CODE_DAILY_CAP=10
STUDENT_TOKEN_TTL_DAYS=30

# Google OAuth client ids (web, android, ios), comma-separated. Blank turns
# Google sign-in off.
GOOGLE_CLIENT_IDS=
STUDENT_GOOGLE_SIGNUP_ENABLED=true

# Google Play reviewer sign-in. Blank = off. A Plan B address and a RANDOM
# 6-digit code (never 123456), given only to Google in Play Console > App
# content > App access. Blank them, or block the account in admin, to stop it.
PLAY_REVIEW_EMAIL=play-review@<domain>
PLAY_REVIEW_CODE=

# --- Payments ------------------------------------------------------------------
# OFF at launch. Read SECURITY_AND_LAUNCH_GUIDE.md P3-10 before setting true.
PAYMENTS_ENABLED=false
# `sandbox` does not exist outside local/testing; production is always `payhere`.
PAYMENT_GATEWAY=payhere
PAYMENT_CURRENCY=LKR
PAYMENT_RETURN_URL=planb://payment/complete
PAYMENT_CANCEL_URL=planb://payment/cancelled

# The merchant secret signs and verifies every amount. It is a credential:
# never logged, never sent to a client.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# These two go together. A live merchant on the sandbox URL (or the reverse)
# fails every checkout.
PAYHERE_SANDBOX=false
PAYHERE_CHECKOUT_URL=https://www.payhere.lk/pay/checkout

BANK_TRANSFER_MAX_RECEIPT_MB=5

# --- Currency converter (display only; never prices anything) -----------------
EXCHANGE_BASE=AED
EXCHANGE_QUOTE=LKR
EXCHANGE_URL="https://open.er-api.com/v6/latest/{base}"
EXCHANGE_REFRESH_HOURS=6
EXCHANGE_STALE_AFTER_HOURS=48
