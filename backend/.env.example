APP_NAME="Plan B International"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# Must be a host the CLIENTS can reach, not just this machine.
# Spatie Media Library builds image URLs from this value statically
# (config/filesystems.php: disks.public.url), unlike Laravel's request-aware
# route/signed-URL helpers. So with APP_URL=localhost the API still works from a
# phone on the LAN while every profile photo and course thumbnail silently 404s
# and falls back to a placeholder. In local LAN development set this to your
# machine's LAN IP (the same host as EXPO_PUBLIC_API_BASE_URL in mobile/.env).
APP_URL=http://localhost:8001

FRONTEND_URL=http://localhost:5183

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=planb
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

SANCTUM_STATEFUL_DOMAINS=localhost:5183

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email. `log` writes emails to storage/logs/laravel.log instead of sending (local only).
# For a cPanel/hosting mailbox use smtp, and either:
#   MAIL_PORT=465 with MAIL_SCHEME=smtps   (SSL)
#   MAIL_PORT=587 with MAIL_SCHEME=smtp    (STARTTLS)
# MAIL_FROM_ADDRESS must be the mailbox you log in with, or one it is allowed to send as.
# Check the settings with: php artisan mail:test you@example.com
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="Plan B Academy"
# Shown in the footer of every email and on the public /account-deletion page. Blank hides the line.
MAIL_SUPPORT_ADDRESS=

# Public legal pages (/privacy, /terms, /account-deletion). See config/legal.php.
# Blank company details are left off the pages. Fill both before launch.
LEGAL_COMPANY_ADDRESS=
LEGAL_COMPANY_REGISTRATION_NUMBER=
LEGAL_PAYMENT_RETENTION_YEARS=7
LEGAL_DELETION_REQUEST_DAYS=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Bunny Stream hosts the lesson videos in production. Left off here: a developer
# machine has no library, so videos fall back to the private local disk and the
# signed playback route. See docs/bunny-stream-setup.md for where each value is
# found in the Bunny dashboard.
BUNNY_STREAM_ENABLED=false
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_STREAM_TOKEN_KEY=
# Each resolution is encoded, stored and billed. 240p/360p are what keep a
# student on weak mobile data watching instead of buffering — don't trim them.
BUNNY_STREAM_RESOLUTIONS=240p,360p,480p,720p
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=

FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=storage/app/firebase-credentials.json

PAYHERE_MERCHANT_ID=
PAYHERE_SECRET=
PAYHERE_SANDBOX=true

WHATSAPP_CONTACT_NUMBER=+94xxxxxxxxx

# --- Student mobile app -------------------------------------------------------
# Students sign in with an emailed one-time code or with Google. There is no SMS.
STUDENT_LOGIN_CODE_TTL_MINUTES=10
STUDENT_LOGIN_CODE_DAILY_CAP=10
STUDENT_TOKEN_TTL_DAYS=30

# One OAuth client id per platform (web, android, ios), comma-separated. Every id
# listed is accepted as a valid audience on an incoming Google ID token.
# Left blank, Google sign-in is disabled: an empty list rejects every token
# rather than accepting any.
GOOGLE_CLIENT_IDS=

# Self-registration. When true, a verified Google account with no student record
# creates one and signs straight in; when false, Google is sign-in only for
# records an admin already loaded. The emailed-code path never registers anyone
# either way — see App\Services\Auth\StudentAuthService.
STUDENT_GOOGLE_SIGNUP_ENABLED=true

# Google Play reviewer sign-in. Reviewers can't read our emails, so this one address
# signs in (and confirms account deletion) with a fixed 6-digit code, and is never
# emailed. OFF while either is blank. Use an address Plan B owns, a random code
# (never 123456), and give both only to Google in Play Console > App content >
# App access. The account is created on first sign-in. Block it in the admin panel,
# or blank these, to stop it at once.
PLAY_REVIEW_EMAIL=
PLAY_REVIEW_CODE=

VITE_APP_NAME="${APP_NAME}" 

#--------------------------------------------------------------------------
# Payments
#--------------------------------------------------------------------------
# Master switch, OFF at launch. While false, no paid order, card checkout or bank
# transfer can start (403) and the app shows "Coming soon" on paid courses and
# services. Free courses still enrol; payments already under way still settle.
# Set true locally to work on the payment flow.
PAYMENTS_ENABLED=false

# `sandbox` settles card payments locally without contacting anyone, so the
# whole order -> payment -> enrolment path works before merchant credentials
# exist. It refuses to run in production. Switch to `payhere` once the merchant
# account is live.
PAYMENT_GATEWAY=sandbox
PAYMENT_CURRENCY=LKR

# Currency converter on the student Home screen. DISPLAY ONLY - this rate never
# prices anything, and no amount derived from it may reach an order.
#
# The default provider needs no account and no key, and does carry LKR, which
# many free feeds do not (the ECB-derived ones publish ~30 currencies without
# it). Swapping to a keyed provider means updating the response parsing in
# ExchangeRateService too, and the key stays here on the server - never in the
# mobile bundle, where it is trivially extractable.
#
# Refreshing needs BOTH a scheduler and a queue worker. Without them the rate
# never updates: the app keeps showing the last one with its date, and flags it
# stale after EXCHANGE_STALE_AFTER_HOURS.
EXCHANGE_BASE=AED
EXCHANGE_QUOTE=LKR
EXCHANGE_URL="https://open.er-api.com/v6/latest/{base}"
EXCHANGE_REFRESH_HOURS=6
EXCHANGE_STALE_AFTER_HOURS=48

# Deep links the gateway sends the student back through. The authoritative
# result never comes from these - it comes from the server-to-server webhook.
PAYMENT_RETURN_URL=planb://payment/complete
PAYMENT_CANCEL_URL=planb://payment/cancelled

# PayHere. The merchant secret signs and verifies every amount - it is a
# credential and must never be logged or sent to a client.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
PAYHERE_CHECKOUT_URL=https://sandbox.payhere.lk/pay/checkout

# Bank transfer (FR-MOB-033/034). The account details and the on/off switch are
# edited in the admin panel under Settings > Bank Details.
BANK_TRANSFER_MAX_RECEIPT_MB=5
